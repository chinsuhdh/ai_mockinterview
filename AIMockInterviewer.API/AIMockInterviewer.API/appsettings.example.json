{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "ConnectionStrings": {
        "DefaultConnection": "Host=your_supabase_host.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_DATABASE_PASSWORD"
    },
    "JwtSettings": {
        "Key": "YOUR_SUPER_SECRET_AND_VERY_LONG_SIGNING_KEY_MINIMUM_32_BYTES_2026",
        "Issuer": "AIMockInterviewer",
        "Audience": "AIMockInterviewerUsers",
        "ExpireMinutes": 1440
    },
    "EmailConfiguration": {
        "SmtpServer": "smtp.gmail.com",
        "SmtpPort": 587,
        "SenderName": "AI Mock Interviewer System",
        "SenderEmail": "YOUR_EMAIL_HERE@fpt.edu.vn",
        "Password": "YOUR_GMAIL_APP_PASSWORD"
    },
    "PayOS": {
        "ClientId": "YOUR_PAYOS_CLIENT_ID",
        "ApiKey": "YOUR_PAYOS_API_KEY",
        "ChecksumKey": "YOUR_PAYOS_CHECKSUM_KEY",
        "ReturnUrl": "http://localhost:3000/payment-success",
        "CancelUrl": "http://localhost:3000/payment-cancel"
    },
    "Gemini": {
        "ApiKey": "YOUR_GEMINI_API_KEY"
    },
    "VNPay": {
        "TmnCode": "YOUR_VNPAY_TMN_CODE",
        "HashSecret": "YOUR_VNPAY_HASH_SECRET",
        "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
        "ReturnUrl": "http://localhost:3000/payment-success",
        "IpnUrl": "https://localhost:xxxx/api/payment/vnpay-ipn"
    }
